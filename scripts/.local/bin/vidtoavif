#!/usr/bin/env bash

local input="$1"
local output="$2"
local fps="$(exiftool "$input" -b -VideoFrameRate)"
local optargs=()
if [[ "$(exiftool "$input" -b -ImageHeight)" -gt 720 ]]; then
    optargs+=("-vf" "scale=-1:720")
fi
ffmpeg -y -i "${input}" -strict -1 -pix_fmt yuva444p -f yuv4mpegpipe "${optargs[@]}" - | avifenc --stdin --fps "${fps}" "${output}"
